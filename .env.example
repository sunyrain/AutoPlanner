# AutoPlanner local environment template.
# Copy to .env locally if you use a dotenv loader. Do not commit .env.

# Optional EnzRetro Transformer one-step proposals.
# Keep the EnzRetro code package, model weights, datasets, and generated outputs
# outside this GitHub repository or under ignored local paths.
AUTOPLANNER_ENABLE_ENZRETRO_PROPOSALS=0
AUTOPLANNER_ENZRETRO_PACKAGE_ROOT=/absolute/path/to/enzretro_model_code_package
AUTOPLANNER_ENZRETRO_MODEL_DIR=/absolute/path/to/enzretro_model_code_package/outputs/enzretro_ft_filtered_strict_singleprod_v1
AUTOPLANNER_ENZRETRO_CHECKPOINT=best_model.pt
AUTOPLANNER_ENZRETRO_VOCAB_FILE=/absolute/path/to/enzretro_model_code_package/enzretro/tokenizer/vocab.txt
AUTOPLANNER_ENZRETRO_DEVICE=cuda
AUTOPLANNER_ENZRETRO_BEAM_SIZE=5
AUTOPLANNER_ENZRETRO_RETURN_TOPK=5
AUTOPLANNER_ENZRETRO_DEDUPE_SUBSTRATE=1
AUTOPLANNER_ENZRETRO_LIPID_FILTER=1
AUTOPLANNER_ENZRETRO_REQUIRE_EXECUTE=1
AUTOPLANNER_ENZRETRO_CHEMISTRY_CONSTRAINTS=1

# Optional ChemEnzy vendor checkout. This folder is intentionally ignored.
AUTOPLANNER_CHEMENZY_VENDOR_ROOT=vendor/ChemEnzyRetroPlanner
