# Optional V4 runtime/data roots. Relative values are resolved by the process.
AUTOPLANNER_RUNTIME_ROOT=D:/autoplanner-runtime
AUTOPLANNER_EXTERNAL_DATA_ROOT=D:/autoplanner-data
AUTOPLANNER_MODEL_ROOT=D:/autoplanner-data/models
AUTOPLANNER_VENDOR_ROOT=D:/autoplanner-vendor
AUTOPLANNER_SOURCE_ROOT=D:/autoplanner-sources

# Configure credentials in the process environment or OS secret manager.
# Never commit a populated .env file or key file.
AUTOPLANNER_CODEX_API_KEY=
# AUTOPLANNER_CODEX_KEY_PATH=C:/secure/autoplanner/codex.key
